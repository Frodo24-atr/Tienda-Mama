# =====================================================
# Solano Moda — Variables de entorno
# =====================================================
# 1. Copiá este archivo como .env.local
# 2. Completá cada valor con tus credenciales reales
# =====================================================

# --- Firebase ---
# Creá un proyecto en https://console.firebase.google.com
# Luego: Configuración del proyecto > Tus apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# --- MercadoPago ---
# Obtené tus credenciales en: https://www.mercadopago.com.ar/developers/panel/app
# Usá el Access Token de PRODUCCIÓN cuando estés listo para cobrar real
# Usá el Access Token de PRUEBA para testing
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# --- URL de la app (para redirecciones de MercadoPago) ---
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
